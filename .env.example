# ==============================================================
# Business (India Edition) - Environment Configuration
# ==============================================================

# --------------------------------------------------------------
# Upstash Redis REST Credentials
# REQUIRED for Vercel Serverless Multiplayer Deployment.
# Obtain these from your Upstash Console:
# https://console.upstash.com -> Create Database -> REST API
# --------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# --------------------------------------------------------------
# Optional: Local WebSocket Server URL
# For local network / host PC multiplayer via server/index.js
# --------------------------------------------------------------
# VITE_WS_URL=ws://localhost:8787

# --------------------------------------------------------------
# Optional: Generic Redis TCP/TLS URL
# For local standalone Redis or Docker instance
# --------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
